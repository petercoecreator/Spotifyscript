-- Tabs: borda sutil e formato de pill preservando o seletor existente.
local function upgradeTab(tab)
    if not tab:IsA("TextButton") then
        return
    end

    local s = addSoftStroke(
        tab,
        Color3.fromRGB(62, 62, 62),
        0.62,
        1
    )

    tab.MouseEnter:Connect(function()
        tween(s, {
            Transparency = 0.28
        }, 0.1)
    end)

    tab.MouseLeave:Connect(function()
        tween(s, {
            Transparency = 0.62
        }, 0.1)
    end)
end

for _, child in ipairs(tabs:GetChildren()) do
    upgradeTab(child)
end

tabs.ChildAdded:Connect(function(child)
    task.defer(function()
        if child and child.Parent == tabs then
            upgradeTab(child)
        end
    end)
end)

-- Resultados/listas: borda muito discreta nas linhas atuais e futuras.
local function upgradeListRow(row)
    if not row:IsA("TextButton") then
        return
    end

    if row:GetAttribute("SpotifyVisualRow") then
        return
    end

    row:SetAttribute("SpotifyVisualRow", true)

    local s = addSoftStroke(
        row,
        Color3.fromRGB(54, 54, 54),
        0.72,
        1
    )

    row.MouseEnter:Connect(function()
        tween(s, {
            Color = Color3.fromRGB(74, 74, 74),
            Transparency = 0.36
        }, 0.1)
    end)

    row.MouseLeave:Connect(function()
        tween(s, {
            Color = Color3.fromRGB(54, 54, 54),
            Transparency = 0.72
        }, 0.1)
    end)
end

for _, child in ipairs(content:GetChildren()) do
    upgradeListRow(child)
end

content.ChildAdded:Connect(function(child)
    task.defer(function()
        if child and child.Parent == content then
            upgradeListRow(child)
        end
    end)
end)

