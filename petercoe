local function addSoftStroke(target, color, transparency, thickness)
    local existing = target:FindFirstChild("VisualStroke")
    if existing then
        existing:Destroy()
    end

    local s = Instance.new("UIStroke")
    s.Name = "VisualStroke"
    s.Color = color or Color3.fromRGB(62, 62, 62)
    s.Transparency = transparency or 0.45
    s.Thickness = thickness or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = target
    return s
end

local function addSoftGradient(target, topColor, bottomColor)
    local existing = target:FindFirstChild("VisualGradient")
    if existing then
        existing:Destroy()
    end

    local g = Instance.new("UIGradient")
    g.Name = "VisualGradient"
    g.Rotation = 90
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, topColor),
        ColorSequenceKeypoint.new(1, bottomColor)
    })
    g.Parent = target
    return g
end

