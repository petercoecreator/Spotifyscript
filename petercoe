-- =========================================================

-- PLAY / PAUSE

-- =========================================================



local playPauseButton



playPauseButton =

    createButton(

        dock,

        "▶",

        UDim2.fromOffset(110, 7),

        UDim2.fromOffset(44, 32),



        function()

            if playPauseBusy then

                return

            end



            playPauseBusy = true



            local current, err =

                api("/current")



            if not current then

                warn(err)

                playPauseBusy = false

                return

            end



            local isPlaying =

                current.is_playing == true



            currentProgress =

                tonumber(

                    current.progress_ms

                )

                or currentProgress



            currentDuration =

                tonumber(

                    current.duration_ms

                )

                or currentDuration



            syncClock = os.clock()



            if isPlaying then

                local result, pauseErr =

                    api(

                        "/pause",

                        "POST"

                    )



                if result ~= nil then

                    playing = false

                    playPauseButton.Text = "▶"

                else

                    warn(pauseErr)

                end

            else

                local result, playErr =

                    api(

                        "/play",

                        "POST"

                    )



                if result ~= nil then

                    playing = true

                    playPauseButton.Text = "II"

                    syncClock = os.clock()

                else

                    warn(playErr)

                end

            end



            task.wait(0.6)



            pcall(syncCurrentTrack)



            playPauseBusy = false

        end

    )



