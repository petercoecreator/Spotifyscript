-- Animacao visual leve baseada no estado atual, sem novas chamadas HTTP.
task.spawn(function()
    while gui.Parent do
        progressKnob.Visible = currentDuration > 0

        if playing then
            tween(coverStroke, {
                Color = C.green,
                Transparency = 0.42
            }, 0.2)

            tween(playGlow, {
                Transparency = 0.28
            }, 0.2)
        else
            tween(coverStroke, {
                Color = Color3.fromRGB(72, 72, 72),
                Transparency = 0.34
            }, 0.2)

            tween(playGlow, {
                Transparency = 0.56
            }, 0.2)
        end

        if statusText.Text == "Conectado" then
            statusGlow.Color = C.green
        else
            statusGlow.Color = C.red
        end

        task.wait(0.35)
    end
end)

