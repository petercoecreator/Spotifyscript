-- =========================================================

-- CAPAS REMOTAS

-- =========================================================



local getAsset =

    getcustomasset

    or getsynasset

    or (syn and syn.getcustomasset)



local imageCache = {}



local function loadRemoteImage(url, callback)

    if not url or url == "" then

        callback("")

        return

    end



    if imageCache[url] then

        callback(imageCache[url])

        return

    end



    if not writefile or not getAsset then

        return

    end



    task.spawn(function()

        local ok, response = pcall(function()

            return requestFn({

                Url = url,

                Method = "GET"

            })

        end)



        if not ok or not response then

            return

        end



        local body =

            response.Body

            or response.body



        if not body then

            return

        end



        local filename =

            "spotify_"

            .. HttpService:GenerateGUID(false)

            :gsub("-", "")

            .. ".jpg"



        local writeOK = pcall(function()

            writefile(filename, body)

        end)



        if not writeOK then

            return

        end



        local assetOK, asset =

            pcall(function()

                return getAsset(filename)

            end)



        if not assetOK or not asset then

            return

        end



        imageCache[url] = asset



        callback(asset)

    end)

end



local function setCurrentCover(url)

    if not url or url == "" then

        cover.Image = ""

        return

    end



    currentCoverURL = url



    loadRemoteImage(url, function(asset)

        if currentCoverURL == url then

            cover.Image = asset

        end

    end)

end



