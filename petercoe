local function seekProgressFromX(x)
    if currentDuration <= 0 then
        return 0
    end

    local left = progressBackground.AbsolutePosition.X
    local width = progressBackground.AbsoluteSize.X

    if width <= 0 then
        return currentProgress
    end

    local percent = math.clamp((x - left) / width, 0, 1)
    return math.floor((currentDuration * percent) + 0.5)
end

local function previewSeek(x)
    if currentDuration <= 0 then
        return
    end

    seekTargetProgress = seekProgressFromX(x)
    currentProgress = seekTargetProgress
    syncClock = os.clock()

    local percent = math.clamp(seekTargetProgress / currentDuration, 0, 1)
    progressFill.Size = UDim2.new(percent, 0, 1, 0)
    currentTimeLabel.Text = formatTime(seekTargetProgress)
end

local function commitSeek()
    if currentDuration <= 0 then
        return
    end

    local target = math.clamp(math.floor(seekTargetProgress + 0.5), 0, currentDuration)
    currentProgress = target
    syncClock = os.clock()

    task.spawn(function()
        local result, err = api("/seek", "POST", {
            position_ms = target
        })

        if result == nil then
            warn("Erro ao adiantar/voltar a musica:", err)
            task.wait(0.15)
            pcall(syncCurrentTrack)
            return
        end

        -- Pequeno atraso para o Spotify aplicar a nova posicao.
        task.wait(0.2)
        pcall(syncCurrentTrack)
    end)
end

progressHitbox.InputBegan:Connect(function(input)
