local function formatTime(ms)

    ms = tonumber(ms) or 0



    local secondsTotal =

        math.max(

            0,

            math.floor(ms / 1000)

        )



    local minutes =

        math.floor(secondsTotal / 60)



    local seconds =

        secondsTotal % 60



    return string.format(

        "%d:%02d",

        minutes,

        seconds

    )

end



