playTrack = function(track)

    if not track or not track.uri then

        return

    end

    -- Guarda a posicao da faixa dentro da lista atualmente exibida.
    -- Isso permite que < e >> naveguem por essa mesma lista.
    for index, queuedTrack in ipairs(activeQueue) do
        if queuedTrack == track
            or (queuedTrack.uri and queuedTrack.uri == track.uri)
            or (queuedTrack.id and track.id and queuedTrack.id == track.id) then
            activeQueueIndex = index
            break
        end
    end



    local result, err =

        api(

            "/play",

            "POST",

            {

                uri = track.uri

            }

        )



    if result == nil then

        warn(

            "Erro ao tocar:",

            err

        )

        return

    end



    playing = true

    currentProgress = 0



    currentDuration =

        tonumber(

            track.duration_ms

        )

        or 0



    syncClock =

        os.clock()



    playPauseButton.Text =

        "II"



    if track.cover then

        setCurrentCover(

            track.cover

        )

    end



    task.wait(0.5)



    pcall(

        syncCurrentTrack

    )

end



