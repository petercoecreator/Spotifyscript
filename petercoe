local function setVolumeBar(percent)
    percent = math.clamp(tonumber(percent) or 0, 0, 100)
    volumePercent = percent
    volumeFill.Size = UDim2.new(1, 0, percent / 100, 0)
end

local function volumeFromY(y)
    local top = volumeTrack.AbsolutePosition.Y
    local height = volumeTrack.AbsoluteSize.Y

    if height <= 0 then
        return volumePercent
    end

    local value = 1 - ((y - top) / height)
    return math.clamp(value * 100, 0, 100)
end

local function sendVolume(percent, force)
    percent = math.clamp(math.floor((tonumber(percent) or 0) + 0.5), 0, 100)
    setVolumeBar(percent)

    local now = os.clock()
    if not force and (now - volumeLastSend) < 0.08 then
        return
    end

    volumeLastSend = now

    task.spawn(function()
        local _, err = api("/volume", "POST", {
            volume_percent = percent
        })

        if err then
            warn("Erro ao alterar volume:", err)
        end
    end)
end

volumeHitbox.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        volumeDragging = true
        sendVolume(volumeFromY(input.Position.Y), true)
    end
end)

UIS.InputChanged:Connect(function(input)
    if volumeDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        sendVolume(volumeFromY(input.Position.Y), false)
    end
end)

UIS.InputEnded:Connect(function(input)
    if volumeDragging and input.UserInputType == Enum.UserInputType.MouseButton1 then
        volumeDragging = false
        sendVolume(volumePercent, true)
    end
end)

